OPENAI_API_KEY=sk-****

# Optional: gate the whole app behind a shared password.
# Leave unset to disable the password screen.
# APP_PASSWORD=your-shared-password

# Optional: override the OpenAI-compatible API base URL.
# Use this for relay services like CherryIN, OpenRouter, etc.
# Leave unset to use OpenAI's official endpoint.
# OPENAI_BASE_URL=https://api.cherryin.ai/v1

# Optional: which model to call. Defaults to gpt-4o.
# Plain OpenAI examples: gpt-5, gpt-5-mini, gpt-4.5, gpt-4o, gpt-4o-mini
# Relay services with provider prefix: openai/gpt-5.5
OPENAI_MODEL=gpt-4o

# Optional: which API endpoint to call. Defaults to "chat".
#   chat       - always use Chat Completions (/v1/chat/completions).
#                Recommended for relay services (CherryIN, OpenRouter, …),
#                most of which do NOT implement /v1/responses. The Thinking
#                toggle still applies `reasoning_effort` on reasoning
#                models, but no streamed reasoning summary is shown.
#   responses  - always use the Responses API (/v1/responses). Required if
#                you want the streamed "thinking" summary visible to the
#                user. Only works against endpoints that support it
#                (OpenAI directly, or relays that implement /v1/responses).
#   auto       - use Responses API only when the user toggles Thinking on
#                a reasoning-capable model (gpt-5, o1, o3, o4); otherwise
#                Chat Completions.
# OPENAI_API_TYPE=chat

# Optional: reasoning depth when the user enables Thinking mode in the UI.
# Applied on any reasoning-capable model (gpt-5 / o-series), regardless of
# whether Chat Completions or Responses API is used.
# Allowed: low | medium | high. Default: medium.
# OPENAI_REASONING_EFFORT=medium

# Optional: how the reasoning summary is generated by OpenAI.
# Only takes effect when the Responses API is used (OPENAI_API_TYPE
# is "responses", or "auto" with thinking enabled on a reasoning model).
# "auto" lets the model decide and tends to skip summaries on follow-up
# turns. Use "detailed" or "concise" to get a summary on every turn.
# Allowed: auto | concise | detailed. Default: detailed.
# OPENAI_REASONING_SUMMARY=detailed

# Optional: how long to wait for the upstream OpenAI/relay response before
# aborting (milliseconds). Helps surface stuck connections instead of
# letting them hang. Default: 110000 (110 seconds).
# UPSTREAM_TIMEOUT_MS=110000
